---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { collectionDefinitions } from '../data/collections';

const paintings = await getCollection('paintings');

const collections = collectionDefinitions.map((collection) => {
  const cover = paintings.find(
    (painting) => painting.id === collection.coverPainting
  );
  const count = paintings.filter(
    (painting) => painting.data.collection === collection.name
  ).length;

  if (!cover) {
    throw new Error(`Missing cover painting: ${collection.coverPainting}`);
  }

  return { ...collection, cover, count };
});
---

<BaseLayout
  title="Gallery | Wil Vark"
  description="Explore collections of contemporary oil paintings by Wil Vark."
>
  <main class="gallery">
    <SiteHeader />

    <header class="gallery-header">
      <p class="eyebrow">Collections</p>
      <h1>Gallery</h1>

      <p class="introduction">
        Contemporary oil paintings of birds, landscapes, and places held in
        memory.
      </p>
    </header>

    <nav class="collection-grid" aria-label="Painting collections">
      {
        collections.map((collection, index) => (
          <a class="collection-card" href={`/gallery/${collection.slug}`}>
            <span class="collection-image">
              <Image
                src={collection.cover.data.image}
                alt=""
                widths={[360, 560, 800, 1120]}
                sizes="(max-width: 759px) calc(100vw - 3rem), 50vw"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
              />
            </span>

            <span class="collection-copy">
              <span class="collection-title">{collection.name}</span>
              <span class="collection-description">
                {collection.description}
              </span>
              <span class="collection-count">
                {collection.count} {collection.count === 1 ? 'work' : 'works'}
              </span>
            </span>
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>

<style>
  .gallery {
    max-width: 78rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 8rem;
  }

  .gallery-header {
    max-width: 44rem;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .introduction {
    margin: 2.5rem auto 0;
    max-width: 36rem;
    color: var(--color-muted);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.55;
  }

  .collection-grid {
    display: grid;
    gap: 4rem;
  }

  .collection-card {
    display: grid;
    gap: 1.75rem;
    color: inherit;
    text-decoration: none;
  }

  .collection-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-line);
  }

  .collection-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .collection-copy {
    display: grid;
    gap: 0.75rem;
  }

  .collection-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .collection-description {
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .collection-count {
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .collection-card:hover .collection-image :global(img),
  .collection-card:focus-visible .collection-image :global(img) {
    transform: scale(1.015);
  }

  .collection-card:hover .collection-title,
  .collection-card:focus-visible .collection-title {
    color: var(--color-muted);
  }

  @media (min-width: 760px) {
    .gallery {
      padding-top: 3.5rem;
    }

    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-image :global(img) {
      transition: none;
    }
  }
</style>
